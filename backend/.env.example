# Supabase project settings (Project Settings -> API)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>   # server-side only, bypasses RLS - never expose to the frontend
SUPABASE_JWT_SECRET=<jwt-secret>               # Project Settings -> API -> JWT Settings, used to verify user access tokens

# Supabase Storage
SUPABASE_STORAGE_BUCKET=images

# CORS
FRONTEND_ORIGIN=https://localhost

# 로깅/환경 (선택, 기본값 있음)
ENVIRONMENT=development
LOG_LEVEL=INFO

# 인증 (MVP: 로그인 화면 미구현). true면 JWT 검증을 건너뛴다 — 로컬/시연 전용
AUTH_DISABLED=true

# 시연용 결제 실패(402) 경로. true면 x-mock-payment-failure 헤더로 카드 승인 거절을
# 재현할 수 있다. AUTH_DISABLED와 분리돼 있으니 시연 때만 켤 것.
MOCK_PAYMENT_FAILURE=false

# ── AI 추론 서버 / 시연 이미지 ────────────────────────────────────────────
# MODEL_API_URL, MODEL_API_TIMEOUT, DEMO_SCAN_IMAGE_BUCKET은 팀 공용 값이라
# docker-compose.yml이 기본값을 준다. 여기에 적어도 **덮어쓰지 못한다** -
# compose의 environment가 env_file보다 우선하기 때문이다. 값을 바꾸려면
# docker-compose.yml을 고치거나, 저장소 루트의 .env / 셸 환경변수를 쓸 것.
#
# AI_CONFIDENCE_THRESHOLD는 compose가 건드리지 않으므로 여기서 조정한다.
# 이 값(0~100) 미만이면 is_below_threshold / needs_review = true.
AI_CONFIDENCE_THRESHOLD=70

# compose 없이 호스트에서 직접 uvicorn을 띄워 디버깅한다면 compose의 기본값이
# 오지 않으므로, 아래를 셸 환경변수로 주거나 주석을 풀 것. 단 Docker로 띄울 때는
# 주석을 풀어도 compose가 이기므로, 값을 바꿀 생각이면 docker-compose.yml을 볼 것.
# MODEL_API_URL=https://<your-domain>.ngrok-free.dev
# MODEL_API_TIMEOUT=10
# DEMO_SCAN_IMAGE_BUCKET=test
