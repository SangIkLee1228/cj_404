# GPU 학습/추론 전용 이미지. 일반 API 서버(backend/Dockerfile)와는 별도로,
# 실제 GPU 인스턴스에 배포할 때만 사용한다.
# 사용: docker compose -f docker-compose.yml -f docker-compose.gpu.yml up --build
FROM nvidia/cuda:12.4.1-runtime-ubuntu22.04

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3.12 python3-pip \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt requirements-gpu.txt ./
# torch/torchvision은 CUDA 버전에 맞춰 설치해야 하므로 requirements-gpu.txt 상단의
# 안내 주석(pytorch.org --index-url)을 따를 것.
RUN pip install --no-cache-dir -r requirements-gpu.txt

COPY . .

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
